  "description": "v2 formula on the freshest cached window (Jun 1-14). Single graded watchlist (<=20) ranked by full-population realized copy-mult (blend = median + 0.25*log1p(mean)). DEPLOY FOR ~1 WEEK then re-run (data ends ~Jun 14; wallets do not persist).",
  "global": {
    "mode": "observe",
    "usd_size_per_trade": 25,
    "max_concurrent_positions": 30,
    "trigger": {
      "event": "watched_wallet_buy",
      "copy_first_buy_only": true,
      "min_trigger_buy_usd": 250,
      "pump_fun_only": true,
      "dedupe_token_across_wallets": true
    },
    "exit": {
      "default": "mirror_wallet_sell",
      "ride_tagged": "our_trailing(SL=-50%,trail=-40%,TP=+900%)"
    },
    "reselect_cadence_days": 7,
    "staleness_note": "selection data ends ~2026-06-14; deploy <=7 days then re-run on recorder"
  },
  "formula": {
    "pool": "early(first-10 by time)+big(first-buy>=$250) on >=2 graduates in lookback",
    "score": "blend = median(full_pop_copy_mult) + 0.25*log1p(mean_copy_mult)",
    "n_floor": 8,
    "top_n": 20,
    "note": "graduate-only ranking FAILS the placebo; the non-grad denominator is the signal"
  },
  "selection_window": "2026-06-01..2026-06-14",
