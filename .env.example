# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/solanatrilly

# Redis (if applicable)
REDIS_URL=redis://redis:6379/0

# Application
SECRET_KEY=change-me-in-production
DEBUG=true
PORT=8000

# External APIs (fill in as needed)
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Docker
COMPOSE_PROJECT_NAME=solanatrilly
